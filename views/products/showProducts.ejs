<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("../partials/_head") %>
</head>
<body>

    <%- include("../partials/_navbar") %>

    <div class="container mt-5">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Product List</h2>

            <a href="/products/add" class="btn btn-primary">
                Add Product
            </a>
        </div>

        <form action="/products" method="GET" class="row mb-3">

            <div class="col-md-10">
                <input
                    type="text"
                    name="search"
                    class="form-control"
                    placeholder="Search product..."
                    value="<%= search || '' %>">
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary w-100">
                    Search
                </button>
            </div>

        </form>

        <table class="table table-bordered table-hover align-middle">

            <thead class="table-dark">
                <tr>
                    <th>No</th>
                    <th>Image</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Supplier</th>
                    <th>Unit Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th width="220">Action</th>
                </tr>
            </thead>

            <tbody>

                <% if (products.length) { %>

                    <% products.forEach((product, index) => { %>

                        <tr>

                            <td><%= index + 1 %></td>

                            <td>
                                <img
                                    src="<%= product.imageUrl %>"
                                    width="80"
                                    height="80"
                                    style="object-fit:cover;"
                                    class="rounded">
                            </td>

                            <td><%= product.name %></td>

                            <td><%= product.Category.name %></td>

                            <td><%= product.Supplier.name %></td>

                            <td>Rp <%= Number(product.price).toLocaleString("id-ID") %></td>

                            <td><%= product.stock %></td>

                            <td>
                                <% if (product.stock === 0) { %>
                                    <span class="badge bg-dark">Out of Stock</span>
                                <% } else if (product.stock <= 5) { %>
                                    <span class="badge bg-danger">Low Stock</span>
                                <% } else { %>
                                    <span class="badge bg-success">Normal</span>
                                <% } %>
                            </td>

                            <td>

                                <a href="/products/<%= product.id %>" class="btn btn-info btn-sm">
                                    Detail
                                </a>

                                <a href="/products/<%= product.id %>/edit" class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a href="/products/<%= product.id %>/delete"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Delete this product?')">
                                    Delete
                                </a>

                            </td>

                        </tr>

                    <% }) %>

                <% } else { %>

                    <tr>
                        <td colspan="9" class="text-center">
                            No products found.
                        </td>
                    </tr>

                <% } %>

            </tbody>

        </table>

        <nav class="mt-3">
            <ul class="pagination justify-content-center">

                <% if (currentPage > 1) { %>
                    <li class="page-item">
                        <a class="page-link"
                        href="/products?page=<%= currentPage - 1 %><%= search ? '&search=' + search : '' %>">
                            Previous
                        </a>
                    </li>
                <% } %>

                <% for (let i = 1; i <= totalPages; i++) { %>

                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                        <a class="page-link"
                        href="/products?page=<%= i %><%= search ? '&search=' + search : '' %>">
                            <%= i %>
                        </a>
                    </li>

                <% } %>

                <% if (currentPage < totalPages) { %>
                    <li class="page-item">
                        <a class="page-link"
                        href="/products?page=<%= currentPage + 1 %><%= search ? '&search=' + search : '' %>">
                            Next
                        </a>
                    </li>
                <% } %>

            </ul>
        </nav>

    </div>

</body>
</html>